version: '3.8'

# Docker Compose configuration for local development
# Run with: docker-compose up --build

services:
  backend:
    build:
      context: .
      dockerfile: web-platform/backend/Dockerfile.dev
    ports:
      - "8000:8000"
    volumes:
      # Mount data directories (read-only for safety)
      - ./standardized_data:/app/standardized_data:ro
      - ./analysis/output:/app/analysis/output:ro
      # Mount backend code for hot reloading during development
      - ./web-platform/backend/R:/app/R:ro
      - ./web-platform/backend/plumber.R:/app/plumber.R:ro
    environment:
      - DATA_DIR=/app/standardized_data
      - R_ENV=development
      # Rate limiting (relaxed for local development)
      - RATE_LIMIT_MAX_REQUESTS=1000
      - RATE_LIMIT_WINDOW_SECONDS=60
      # CORS (permissive for local development)
      - CORS_ALLOWED_ORIGINS=*
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  frontend:
    build:
      context: ./web-platform/frontend
      dockerfile: Dockerfile.dev
    ports:
      - "5173:5173"
    depends_on:
      backend:
        condition: service_healthy
    volumes:
      # Mount source code for hot reloading
      - ./web-platform/frontend/src:/app/src:ro
      - ./web-platform/frontend/public:/app/public:ro
      - ./web-platform/frontend/index.html:/app/index.html:ro
    environment:
      - VITE_API_URL=http://localhost:8000/api
    stdin_open: true
    tty: true

# Optional: Add a network for explicit service discovery
networks:
  default:
    name: coral-platform-network
